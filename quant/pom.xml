<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nablatensor</groupId>
    <artifactId>quant-parent</artifactId>
    <version>0.4.0</version>
  </parent>
  <artifactId>quant</artifactId>
  <name>NablaTensor Quant</name>
  <dependencies>
    <dependency>
      <groupId>com.nablatensor</groupId>
      <artifactId>quant-codegen</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.nablatensor</groupId>
      <artifactId>jax4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.nablatensor</groupId>
              <artifactId>quant-codegen</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <description>Quantitative finance: products, Monte Carlo, models, calibration, curves, scenarios, lattice and credit on JAX4J.</description>
</project>
